# Required
TELEGRAM_BOT_TOKEN=

# Storage. Without MONGO_URI, JSON files are written under DATA_DIR (mount it as a volume).
MONGO_URI=
MONGO_DB=fetchig
DATA_DIR=./data

# Optional: how the bot talks to Instagram (shared by all users)
IG_PROXY=
IG_DELAY_RANGE=1,3
IG_LOCALE=
IG_COUNTRY=
IG_COUNTRY_CODE=
IG_TIMEZONE_OFFSET=
IG_TLS_VERIFY=true

# Optional: limits
MAX_MEDIA_MB=50
MAX_WATCH=10
CODE_TIMEOUT=300
LOG_LEVEL=INFO
